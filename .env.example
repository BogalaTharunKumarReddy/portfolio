# Copy to .env.local and fill in. Variables prefixed VITE_ are bundled into the
# public site, so only put PUBLIC values here, never private API keys.

# Contact form endpoint (e.g. a free Formspree form: https://formspree.io/f/xxxxxxxx).
# Leave empty to fall back to opening the visitor's email app (mailto:).
VITE_CONTACT_ENDPOINT=
